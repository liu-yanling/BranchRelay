# 复制为 backend/.env 后填写（backend/.env 已被 .gitignore 忽略，不会进仓库）。
# 本产品不上线，本地运行即可。

# ---------- 模型（阶段 2-2 使用，阶段 2-1 留空即可） ----------
MODEL_API_BASE=https://api.openai-next.com/v1
MODEL_NAME=gpt-6.2-astra
MODEL_API_KEY=
# 单次模型调用超时（秒）与网络类错误额外重试次数
MODEL_TIMEOUT=30
MODEL_MAX_RETRIES=1

# ---------- 演示时钟 ----------
# 固定演示时间；留空则用真实当前时间
DEMO_TIME=2026-11-20T10:00:00+08:00

# ---------- 服务 ----------
PORT=8000
# SQLite 文件路径；默认放在产品文件夹的 data/ 下（已被 .gitignore 忽略）
# DB_PATH=../data/branchrelay.db
